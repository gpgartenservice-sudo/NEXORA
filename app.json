{
  "expo": {
    "name": "Lunaxora",
    "slug": "nexora",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nexora",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.lunaxora.app",
      "appleTeamId": "9BUNT8S2Y6"
    },
    "android": {
      "package": "de.lunaxora.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Lunaxora",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sharing",
      "expo-mail-composer",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lunaxora öffnet deine Fotos, damit du Belege und dein Logo auswählen kannst.",
          "cameraPermission": "Lunaxora nutzt die Kamera, damit du Belege fotografieren kannst – Luna liest sie dann aus.",
          "microphonePermission": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Lunaxora nutzt den Bewegungssensor, damit Luna mitrollt, wenn du dein Handy kippst."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Lunaxora nutzt das Mikrofon nur, wenn du mit Luna sprichst."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
